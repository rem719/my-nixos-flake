 #endif				/* USE_XINERAMA */
 }
 
+
+void wRefreshXinerama(WScreen * scr)
+{
+        int old_heads = wXineramaHeads(scr);
+        int new_heads;
+
+        wfree(scr->xine_info.screens);
+        scr->xine_info.screens = NULL;
+        scr->xine_info.count = 0;
+
+        wInitXinerama(scr);
+
+        new_heads = wXineramaHeads(scr);
+
+        if (new_heads != old_heads) {
+                scr->usableArea = wrealloc(scr->usableArea,
+                        sizeof(WArea) * new_heads);
+                scr->totalUsableArea = wrealloc(scr->totalUsableArea,
+                        sizeof(WArea) * new_heads);
+        }
+
+        wScreenUpdateUsableArea(scr);
+}
